{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kurokawa-logistics-language",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "routes": [
    {
      "pattern": "kurokawa-logistics.com/*",
      "zone_name": "kurokawa-logistics.com"
    }
  ]
}
